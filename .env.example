# US Census Bureau API Key (Get key at: https://api.census.gov/data/key_signup.html)
CENSUS_API_KEY=your_census_api_key_here

# Supabase Credentials
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: Socrata application token for higher municipal crime-data rate limits.
# The safety feature works without it on the public rate limit.
SOCRATA_APP_TOKEN=
